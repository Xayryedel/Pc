  <!-- Зависимости -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <script>
  'use strict';

  /* ==============================================================
     NEBULA — модульный код лендинга
     Разделы:
       1. Конфигурация и утилиты
       2. NebulaScene — WebGL-сцена (Three.js)
       3. Preloader
       4. CustomCursor
       5. MagneticButtons
       6. TiltCards
       7. ScrollAnimations (GSAP)
       8. Бутстрап
     ============================================================== */

  /* --------------------------------------------------------------
     1. Конфигурация и утилиты
     -------------------------------------------------------------- */
  const CONFIG = Object.freeze({
    dprMax: 2,
    starLayers: [
      { count: 9000, size: 2.2, spread: 60, color: 0xffffff, opacity: 0.9, parallax: 0.05 },
      { count: 5000, size: 3.6, spread: 42, color: 0x8b5cf6, opacity: 0.75, parallax: 0.10 },
      { count: 3000, size: 4.5, spread: 30, color: 0x22d3ee, opacity: 0.65, parallax: 0.16 },
    ],
    rocksCount: 14,
    glitchIntervalMs: 3400,
    glitchProbability: 0.45,
    cursorLerp: 0.16,
    cameraLerp: 0.045,
    reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    isTouch: window.matchMedia('(hover: none)').matches,
  });

  /** Безопасное получение DOM-элемента. */
  function $(selector, root = document) {
    const el = root.querySelector(selector);
    if (!el) console.warn(`[NEBULA] Элемент не найден: ${selector}`);
    return el;
  }

  function $$(selector, root = document) {
    return Array.from(root.querySelectorAll(selector));
  }

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  /* --------------------------------------------------------------
     2. NebulaScene — WebGL-сцена
     -------------------------------------------------------------- */
  class NebulaScene {
    /**
     * @param {HTMLCanvasElement} canvas
     */
    constructor(canvas) {
      this.canvas = canvas;
      this.isRunning = false;
      this.scrollY = 0;
      this.pointer = { x: 0, y: 0 };   // целевые координаты (-1..1)
      this.smoothPointer = { x: 0, y: 0 };
      this._rockData = [];

      this._init();
      this._bindEvents();
    }

    /** Инициализация рендерера, сцены, камеры и объектов. */
    _init() {
      this.renderer = new THREE.WebGLRenderer({
        canvas: this.canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      });
      this.renderer.setPixelRatio(clamp(window.devicePixelRatio, 1, CONFIG.dprMax));
      this.renderer.setSize(window.innerWidth, window.innerHeight);

      this.scene = new THREE.Scene();
      this.scene.fog = new THREE.FogExp2(0x04030a, 0.045);

      this.camera = new THREE.PerspectiveCamera(
        62, window.innerWidth / window.innerHeight, 0.1, 200
      );
      this.camera.position.set(0, 0, 14);

      this.clock = new THREE.Clock();

      this._buildStarLayers();
      this._buildKnot();
      this._buildRocks();
    }

    /** Три слоя звёзд с индивидуальными параметрами параллакса. */
    _buildStarLayers() {
      this.starLayers = CONFIG.starLayers.map((cfg) => {
        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(cfg.count * 3);
        const phases = new Float32Array(cfg.count);
        const speeds = new Float32Array(cfg.count);

        for (let i = 0; i < cfg.count; i++) {
          positions[i * 3]     = (Math.random() - 0.5) * cfg.spread;
          positions[i * 3 + 1] = (Math.random() - 0.5) * cfg.spread;
          positions[i * 3 + 2] = (Math.random() - 0.5) * cfg.spread;
          phases[i] = Math.random() * Math.PI * 2;
          speeds[i] = 0.3 + Math.random() * 1.2;
        }

        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('aPhase', new THREE.BufferAttribute(phases, 1));
        geometry.setAttribute('aSpeed', new THREE.BufferAttribute(speeds, 1));

        const material = new THREE.ShaderMaterial({
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          uniforms: {
            uTime:    { value: 0 },
            uSize:    { value: cfg.size },
            uColor:   { value: new THREE.Color(cfg.color) },
            uOpacity: { value: cfg.opacity },
          },
          vertexShader: /* glsl */`
            attribute float aPhase;
            attribute float aSpeed;
            uniform float uTime;
            uniform float uSize;
            varying float vTwinkle;

            void main() {
              vTwinkle = 0.55 + 0.45 * sin(uTime * aSpeed + aPhase);
              vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
              gl_PointSize = uSize * (1.0 + vTwinkle) * (140.0 / -mvPosition.z);
              gl_Position = projectionMatrix * mvPosition;
            }`,
          fragmentShader: /* glsl */`
            uniform vec3 uColor;
            uniform float uOpacity;
            varying float vTwinkle;

            void main() {
              float dist = length(gl_PointCoord - 0.5);
              float alpha = smoothstep(0.5, 0.0, dist);
              gl_FragColor = vec4(uColor, alpha * alpha * uOpacity * vTwinkle);
            }`,
        });

        const points = new THREE.Points(geometry, material);
        this.scene.add(points);

        return { points, cfg };
      });
    }

    /** Торус-узел с вершинным смещением через Simplex noise (GLSL). */
    _buildKnot() {
      this.knotGeometry = new THREE.TorusKnotGeometry(4.2, 1.05, 220, 32);

      this.knotMaterial = new THREE.ShaderMaterial({
        wireframe: true,
        transparent: true,
        uniforms: { uTime: { value: 0 } },
        vertexShader: /* glsl */`
          uniform float uTime;
          varying float vNoise;

          // --- Simplex noise 3D (Ashima Arts / stegu, MIT) ---
          vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
          vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
          vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
          vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

          float snoise(vec3 v) {
            const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
            const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);

            vec3 i = floor(v + dot(v, C.yyy));
            vec3 x0 = v - i + dot(i, C.xxx);

            vec3 g = step(x0.yzx, x0.xyz);
            vec3 l = 1.0 - g;
            vec3 i1 = min(g.xyz, l.zxy);
            vec3 i2 = max(g.xyz, l.zxy);

            vec3 x1 = x0 - i1 + C.xxx;
            vec3 x2 = x0 - i2 + C.yyy;
            vec3 x3 = x0 - D.yyy;

            i = mod289(i);
            vec4 p = permute(permute(permute(
              i.z + vec4(0.0, i1.z, i2.z, 1.0))
              + i.y + vec4(0.0, i1.y, i2.y, 1.0))
              + i.x + vec4(0.0, i1.x, i2.x, 1.0));

            float n_ = 0.142857142857;
            vec3 ns = n_ * D.wyz - D.xzx;

            vec4 j = p - 49.0 * floor(p * ns.z * ns.z);

            vec4 x_ = floor(j * ns.z);
            vec4 y_ = floor(j - 7.0 * x_);

            vec4 x = x_ * ns.x + ns.yyyy;
            vec4 y = y_ * ns.x + ns.yyyy;
            vec4 h = 1.0 - abs(x) - abs(y);

            vec4 b0 = vec4(x.xy, y.xy);
            vec4 b1 = vec4(x.zw, y.zw);

            vec4 s0 = floor(b0) * 2.0 + 1.0;
            vec4 s1 = floor(b1) * 2.0 + 1.0;
            vec4 sh = -step(h, vec4(0.0));

            vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
            vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

            vec3 p0 = vec3(a0.xy, h.x);
            vec3 p1 = vec3(a0.zw, h.y);
            vec3 p2 = vec3(a1.xy, h.z);
            vec3 p3 = vec3(a1.zw, h.w);

            vec4 norm = taylorInvSqrt(vec4(
              dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)
            ));
            p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;

            vec4 m = max(0.6 - vec4(
              dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)
            ), 0.0);
            m = m * m;

            return 42.0 * dot(m * m, vec4(
              dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)
            ));
          }
          // --- конец simplex noise ---

          void main() {
            float n = snoise(position * 0.35 + uTime * 0.25);
            vec3 displaced = position + normal * n * 0.85;
            vNoise = n;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(displaced, 1.0);
          }`,
        fragmentShader: /* glsl */`
          uniform float uTime;
          varying float vNoise;

          void main() {
            vec3 violet = vec3(0.545, 0.361, 0.965);
            vec3 cyan   = vec3(0.133, 0.827, 0.933);
            vec3 color  = mix(violet, cyan, vNoise * 0.5 + 0.5);
            gl_FragColor = vec4(color, 0.5 + 0.3 * sin(uTime * 2.0 + vNoise * 6.0));
          }`,
      });

      this.knot = new THREE.Mesh(this.knotGeometry, this.knotMaterial);
      this.scene.add(this.knot);
    }

    /** Плавающие wireframe-икосаэдры. */
    _buildRocks() {
      for (let i = 0; i < CONFIG.rocksCount; i++) {
        const radius = 0.25 + Math.random() * 0.6;
        const color = Math.random() > 0.5 ? 0x8b5cf6 : 0x22d3ee;

        const rock = new THREE.Mesh(
          new THREE.IcosahedronGeometry(radius, 0),
          new THREE.MeshBasicMaterial({
            color,
            wireframe: true,
            transparent: true,
            opacity: 0.55,
          })
        );

        rock.position.set(
          (Math.random() - 0.5) * 26,
          (Math.random() - 0.5) * 16,
          (Math.random() - 0.5) * 12 - 4
        );

        this._rockData.push({
          mesh: rock,
          rotationSpeedX: (Math.random() - 0.5) * 0.01,
          rotationSpeedY: (Math.random() - 0.5) * 0.01,
          floatPhase: Math.random() * Math.PI * 2,
          floatSpeed: 0.4 + Math.random() * 0.8,
        });

        this.scene.add(rock);
      }
    }

    /** Подписка на события окна. */
    _bindEvents() {
      this._onResize = this._handleResize.bind(this);
      this._onPointerMove = this._handlePointerMove.bind(this);
      this._onScroll = this._handleScroll.bind(this);
      this._onVisibility = this._handleVisibility.bind(this);

      window.addEventListener('resize', this._onResize, { passive: true });
      window.addEventListener('mousemove', this._onPointerMove, { passive: true });
      window.addEventListener('scroll', this._onScroll, { passive: true });
      document.addEventListener('visibilitychange', this._onVisibility);
      this.canvas.addEventListener('webglcontextlost', (e) => {
        e.preventDefault();
        this.pause();
        this._showFallback();
      });
    }

    _handleResize() {
      this.camera.aspect = window.innerWidth / window.innerHeight;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(window.innerWidth, window.innerHeight);
    }

    _handlePointerMove(event) {
      this.pointer.x = (event.clientX / window.innerWidth - 0.5) * 2;
      this.pointer.y = (event.clientY / window.innerHeight - 0.5) * 2;
    }

    _handleScroll() {
      this.scrollY = window.scrollY;
    }

    /** Пауза рендера в неактивной вкладке — экономия ресурсов. */
    _handleVisibility() {
      if (document.hidden) this.pause(); else this.start();
    }

    _showFallback() {
      const fallback = $('#webgl-fallback');
      if (fallback) fallback.hidden = false;
    }

    /** Единственный RAF-цикл сцены. */
    _render = () => {
      if (!this.isRunning) return;
      this._rafId = requestAnimationFrame(this._render);

      const t = this.clock.getElapsedTime();
      const { x, y } = this.smoothPointer;

      // Звёздные слои: вращение + параллакс от указателя
      this.starLayers.forEach((layer, i) => {
        layer.points.material.uniforms.uTime.value = t;
        layer.points.rotation.y = t * 0.008 * (i + 1) + x * layer.cfg.parallax * (i + 1);
        layer.points.rotation.x = y * layer.cfg.parallax * 0.6 * (i + 1);
      });

      // Торус-узел
      this.knotMaterial.uniforms.uTime.value = t;
      this.knot.rotation.y = t * 0.12 + x * 0.3;
      this.knot.rotation.x = t * 0.06 + y * 0.2;
      this.knot.position.z = -this.scrollY * 0.004;

      // Икосаэдры
      this._rockData.forEach((data) => {
        data.mesh.rotation.x += data.rotationSpeedX;
        data.mesh.rotation.y += data.rotationSpeedY;
        data.mesh.position.y += Math.sin(t * data.floatSpeed + data.floatPhase) * 0.004;
      });

      // Камера: плавное следование за указателем + дрейф + скролл
      this.camera.position.x = x * 1.6 + Math.sin(t * 0.1) * 0.4;
      this.camera.position.y = -y * 1.2 - this.scrollY * 0.002 + Math.cos(t * 0.13) * 0.3;
      this.camera.position.z = 14 - this.scrollY * 0.003;
      this.camera.lookAt(0, -this.scrollY * 0.002, 0);

      this.renderer.render(this.scene, this.camera);
    };

    /** Цикл интерполяции указателя (независим от рендера). */
    _lerpPointer = () => {
      this.smoothPointer.x += (this.pointer.x - this.smoothPointer.x) * CONFIG.cameraLerp;
      this.smoothPointer.y += (this.pointer.y - this.smoothPointer.y) * CONFIG.cameraLerp;
      this._lerpId = requestAnimationFrame(this._lerpPointer);
    };

    start() {
      if (this.isRunning) return;
      this.isRunning = true;
      this.clock.getDelta(); // сброс накопленного дельта-времени
      this._render();
    }

    pause() {
      this.isRunning = false;
      cancelAnimationFrame(this._rafId);
    }

    /** Освобождение GPU-ресурсов. */
    dispose() {
      this.pause();
      cancelAnimationFrame(this._lerpId);
      window.removeEventListener('resize', this._onResize);
      window.removeEventListener('mousemove', this._onPointerMove);
      window.removeEventListener('scroll', this._onScroll);
      document.removeEventListener('visibilitychange', this._onVisibility);

      this.scene.traverse((obj) => {
        if (obj.geometry) obj.geometry.dispose();
        if (obj.material) {
          Object.values(obj.material).forEach((v) => {
            if (v && v.isTexture) v.dispose();
          });
          obj.material.dispose();
        }
      });
      this.renderer.dispose();
    }
  }

  /* --------------------------------------------------------------
     3. Preloader
     -------------------------------------------------------------- */
  class Preloader {
    /**
     * @param {Object} callbacks
     * @param {Function} callbacks.onComplete
     */
    constructor({ onComplete }) {
      this.root = $('#preloader');
      this.number = $('#loader-number');
      this.bar = $('#loader-bar');
      this._onComplete = onComplete;
      this._progress = 0;

      if (!this.root) { onComplete(); return; }
      this._tick = this._tick.bind(this);
      this._interval = setInterval(this._tick, 90);
    }

    _tick() {
      // Плавное приближение к 100 со случайным шагом
      this._progress = Math.min(100, this._progress + Math.random() * 14);
      const value = Math.floor(this._progress);

      if (this.number) this.number.textContent = `${value}%`;
      if (this.bar) this.bar.style.width = `${value}%`;

      if (this._progress >= 100) {
        clearInterval(this._interval);
        this.root.classList.add('is-done');
        this.root.addEventListener('transitionend', () => {
          this.root.style.display = 'none';
        }, { once: true });
        this._onComplete();
      }
    }
  }

  /* --------------------------------------------------------------
     4. CustomCursor — точка следует мгновенно, кольцо с инерцией
     -------------------------------------------------------------- */
  class CustomCursor {
    constructor() {
      if (CONFIG.isTouch || CONFIG.reducedMotion) return;

      this.dot = $('#cursor-dot');
      this.ring = $('#cursor-ring');
      this.target = { x: innerWidth / 2, y: innerHeight / 2 };
      this.ringPos = { ...this.target };

      if (!this.dot || !this.ring) return;

      window.addEventListener('mousemove', (e) => {
        this.target.x = e.clientX;
        this.target.y = e.clientY;
      }, { passive: true });

      this._loop = this._loop.bind(this);
      requestAnimationFrame(this._loop);

      // Подсветка интерактивных элементов
      $$('a, button, [data-tilt]').forEach((el) => {
        el.addEventListener('mouseenter', () => this.ring.classList.add('is-hovering'));
        el.addEventListener('mouseleave', () => this.ring.classList.remove('is-hovering'));
      });
    }

    _loop() {
      this.ringPos.x += (this.target.x - this.ringPos.x) * CONFIG.cursorLerp;
      this.ringPos.y += (this.target.y - this.ringPos.y) * CONFIG.cursorLerp;

      this.dot.style.transform =
        `translate(${this.target.x}px, ${this.target.y}px) translate(-50%, -50%)`;
      this.ring.style.transform =
        `translate(${this.ringPos.x}px, ${this.ringPos.y}px) translate(-50%, -50%)`;

      requestAnimationFrame(this._loop);
    }
  }

  /* --------------------------------------------------------------
     5. MagneticButtons — притяжение к курсору с elastic-возвратом
     -------------------------------------------------------------- */
  class MagneticButtons {
    constructor() {
      if (CONFIG.isTouch || CONFIG.reducedMotion) return;

      $$('.magnetic').forEach((btn) => {
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const dx = e.clientX - rect.left - rect.width / 2;
          const dy = e.clientY - rect.top - rect.height / 2;
          gsap.to(btn, { x: dx * 0.35, y: dy * 0.35, duration: 0.4 });
        });

        btn.addEventListener('mouseleave', () => {
          gsap.to(btn, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
        });
      });
    }
  }

  /* --------------------------------------------------------------
     6. TiltCards — 3D-наклон + spotlight за курсором
     -------------------------------------------------------------- */
  class TiltCards {
    constructor() {
      if (CONFIG.isTouch || CONFIG.reducedMotion) return;

      $$('[data-tilt]').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const px = e.clientX - rect.left;
          const py = e.clientY - rect.top;

          card.style.setProperty('--spot-x', `${px}px`);
          card.style.setProperty('--spot-y', `${py}px`);

          gsap.to(card, {
            rotateY: (px / rect.width - 0.5) * 14,
            rotateX: -(py / rect.height - 0.5) * 14,
            duration: 0.5,
            ease: 'power2.out',
            transformPerspective: 900,
          });
        });

        card.addEventListener('mouseleave', () => {
          gsap.to(card, {
            rotateX: 0, rotateY: 0,
            duration: 0.8, ease: 'elastic.out(1, 0.5)',
          });
        });
      });
    }
  }

  /* --------------------------------------------------------------
     7. ScrollAnimations — GSAP/ScrollTrigger
     -------------------------------------------------------------- */
  const ScrollAnimations = {
    /** Построчная маска для заголовков секций. */
    splitTitles() {
      $$('[data-split-title]').forEach((title) => {
        const lines = title.innerHTML.split(/<br\s*\/?>/i);
        title.innerHTML = lines
          .map((line) =>
            `<span class="split-line"><span class="split-line__inner">${line}</span></span>`
          )
          .join('');

        gsap.to(title.querySelectorAll('.split-line__inner'), {
          y: 0,
          duration: 1.1,
          stagger: 0.15,
          ease: 'power4.out',
          scrollTrigger: { trigger: title, start: 'top 82%' },
        });
      });
    },

    /** Появление блоков при скролле. */
    reveals() {
      $$('.will-fade-up').forEach((el, i) => {
        gsap.to(el, {
          opacity: 1,
          y: 0,
          duration: 1,
          ease: 'power3.out',
          delay: (i % 4) * 0.08,
          scrollTrigger: { trigger: el, start: 'top 88%' },
        });
      });
    },

    /** Анимированные счётчики (срабатывают один раз). */
    counters() {
      $$('.counter').forEach((counter) => {
        const target = Number(counter.dataset.target);
        if (!Number.isFinite(target)) return;

        const state = { value: 0 };
        ScrollTrigger.create({
          trigger: counter,
          start: 'top 88%',
          once: true,
          onEnter: () => gsap.to(state, {
            value: target,
            duration: 2.2,
            ease: 'power2.out',
            onUpdate: () => {
              counter.textContent = Math.floor(state.value).toLocaleString('ru-RU');
            },
          }),
        });
      });
    },

    /** Вводная анимация hero-секции после прелоадера. */
    heroIntro() {
      if (CONFIG.reducedMotion) {
        gsap.set(['#hero-tag', '#hero-glitch', '#hero-subtitle', '#hero-actions', '#scroll-hint'],
          { opacity: 1, clearProps: 'transform' });
        return;
      }

      const timeline = gsap.timeline({ delay: 0.3 });
      timeline
        .to('#hero-tag',      { opacity: 1, duration: 0.8, ease: 'power2.out' })
        .to('#hero-glitch',   { opacity: 1, duration: 0.01, onStart: GlitchController.trigger }, '-=0.4')
        .to('#hero-subtitle', { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out' }, '-=0.1')
        .to('#hero-actions',  { opacity: 1, duration: 0.8 }, '-=0.5')
        .to('#scroll-hint',   { opacity: 1, duration: 0.8 }, '-=0.4');
    },

    init() {
      this.splitTitles();
      this.reveals();
      this.counters();
    },
  };

  /* --------------------------------------------------------------
     GlitchController — управление RGB-разрывом заголовка
     -------------------------------------------------------------- */
  const GlitchController = {
    el: null,
    _timeoutId: null,

    init() {
      if (CONFIG.reducedMotion) return;
      this.el = $('#hero-glitch');
      if (!this.el) return;

      setInterval(() => {
        if (Math.random() > CONFIG.glitchProbability) this.trigger();
      }, CONFIG.glitchIntervalMs);
    },

    trigger() {
      if (!this.el) return;
      this.el.classList.add('is-glitching');
      clearTimeout(this._timeoutId);
      this._timeoutId = setTimeout(() => {
        this.el.classList.remove('is-glitching');
      }, 380);
    },
  };

  /* --------------------------------------------------------------
     8. Бутстрап приложения
     -------------------------------------------------------------- */
  (function bootstrap() {
    // Гарантированный fallback, если WebGL недоступен
    let scene = null;
    try {
      if (!window.THREE) throw new Error('Three.js не загружен');
      scene = new NebulaScene($('#webgl'));
      scene.start();
      scene._lerpPointer();
    } catch (error) {
      console.error('[NEBULA] WebGL-инициализация не удалась:', error);
      const fallback = $('#webgl-fallback');
      const canvas = $('#webgl');
      if (canvas) canvas.remove();
      if (fallback) fallback.hidden = false;
    }

    // Выгрузка ресурсов при закрытии страницы
    window.addEventListener('pagehide', () => scene && scene.dispose(), { once: true });

    // GSAP-анимации
    if (window.gsap && window.ScrollTrigger) {
      gsap.registerPlugin(ScrollTrigger);
      ScrollAnimations.init();
    } else {
      console.warn('[NEBULA] GSAP недоступен — контент показан без анимаций.');
      $$('.will-fade-up').forEach((el) => {
        el.style.opacity = 1;
        el.style.transform = 'none';
      });
      $$('.split-line__inner').forEach((el) => { el.style.transform = 'none'; });
    }

    // Дублирование контента бегущей строки для бесшовного цикла
    const track = $('#marquee-track');
    if (track) track.innerHTML += track.innerHTML;

    // Интерактивные модули
    new CustomCursor();
    new MagneticButtons();
    new TiltCards();
    GlitchController.init();

    // Прелоадер → вводная анимация
    new Preloader({
      onComplete: () => ScrollAnimations.heroIntro(),
    });
  })();
  </script>
